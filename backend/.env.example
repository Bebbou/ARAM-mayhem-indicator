# Copie ce fichier en ".env" (même dossier) et remplis ta clé.
# Ne JAMAIS commit le fichier .env réel (il est dans .gitignore).

RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Plateforme où chercher les joueurs de départ (euw1, na1, kr, eune1, ...)
PLATFORM=euw1

# Routing régional pour Match-V5 (europe, americas, asia, sea)
REGIONAL=europe

# Nombre de matchs uniques ARAM Mayhem (queue 2400) à collecter avant d'arrêter
TARGET_MATCHES=50
